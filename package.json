{
  "name": "oira666_pi-subagent",
  "version": "0.4.3",
  "description": "Subagent extension for Pi coding agent. Delegate tasks to specialized agents.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "agents.ts",
    "budget.ts",
    "config.ts",
    "runner.ts",
    "resume.ts",
    "names.ts",
    "agent-names.ts",
    "shared.ts",
    "render.ts",
    "detail.ts",
    "overlay.ts",
    "tree.ts",
    "types.ts",
    "agents/*.md",
    "README.md",
    "LICENSE",
    "extension/",
    "runner/",
    "storage/",
    "types/",
    "ui/",
    "docs/",
    "create-subagent/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "subagent",
    "delegation",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-subagent.git"
  },
  "bugs": {
    "url": "https://github.com/gee666/pi-subagent/issues"
  },
  "homepage": "https://github.com/gee666/pi-subagent#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --import tsx/esm --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"*.ts\" \"{extension,runner,storage,types,ui,test}/**/*.ts\" \"scripts/*.mjs\" package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"*.ts\" \"{extension,runner,storage,types,ui,test}/**/*.ts\" \"scripts/*.mjs\" package.json tsconfig.json .prettierrc.json",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run format:check && npm run check:size && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^25.2.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@sinclair/typebox": ">=0.34.0"
  }
}
