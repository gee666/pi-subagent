{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "extension/**/*.ts",
    "runner/**/*.ts",
    "storage/**/*.ts",
    "types/**/*.ts",
    "ui/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
